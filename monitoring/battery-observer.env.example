# Copy to battery-observer.env and fill in your details, then either:
#   set -a; source battery-observer.env; set +a; ./battery-observer.sh
# or let install-observer.sh load it into a systemd service.

# Where to send notifications (required).
BATTERY_OBSERVER_TO=you@example.com

# SMTP relay to send through (required). No auth is used -- this assumes an
# open/internal relay reachable from the machine. Examples:
#   smtp://smtp.example.com:25
#   smtp://localhost:25
BATTERY_OBSERVER_RELAY=smtp://smtp.example.com:25

# Sender address (optional; defaults to battery-observer@<hostname>).
#BATTERY_OBSERVER_FROM=battery-observer@example.com

# Low-battery warning threshold in percent (optional; default 40).
#BATTERY_OBSERVER_LOW=40
